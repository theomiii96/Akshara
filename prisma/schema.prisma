// Prisma schema for Akshara Farmer Producer Company

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ── Company Staff (Admin Login) ─────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("ADMIN") // ADMIN, STAFF
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Farmer Accounts (Farmer Login) ─────────────────────────────────────────
model FarmerAccount {
  id        String      @id @default(cuid())
  name      String
  phone     String      @unique
  village   String
  district  String
  password  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  orders    SeedOrder[]
}

// ── Seed Stock (Managed by Company) ────────────────────────────────────────
model Seed {
  id            String      @id @default(cuid())
  name          String      // e.g. "Akshara Super Red Onion Seed"
  variety       String      // e.g. "N-2-4-1 (Garwa Selection)"
  category      String      @default("Onion") // Onion, Maize, Paddy, Vegetable etc.
  description   String?
  quantityKg    Float       // total available stock in kg
  pricePerKg    Float       // INR per kg
  minOrderKg    Float       @default(0.5)
  maxOrderKg    Float       @default(25.0)
  isActive      Boolean     @default(true)
  imageUrl      String?
  season        String?     // Rabi, Kharif, All Season
  germinationPct Float?     // e.g. 92.0
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orders        SeedOrder[]
}

// ── Seed Orders (Placed by Farmers) ────────────────────────────────────────
model SeedOrder {
  id              String        @id @default(cuid())
  orderCode       String        @unique
  farmerAccountId String
  farmer          FarmerAccount @relation(fields: [farmerAccountId], references: [id], onDelete: Cascade)
  seedId          String
  seed            Seed          @relation(fields: [seedId], references: [id], onDelete: Restrict)
  quantityKg      Float
  pricePerKg      Float         // snapshot at time of order
  totalAmount     Float
  status          String        @default("PENDING") // PENDING, CONFIRMED, DISPATCHED, DELIVERED
  notes           String?
  orderedAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
